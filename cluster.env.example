# cluster.env: YOUR settings for this repository. Copy to cluster.env (git-ignored), replace every <your-...> value, then run
#   scripts/configure.sh --check     (shows the diff, changes nothing)   and   scripts/configure.sh     (writes the files).
# Nothing in this file is secret. Every variable is documented in docs/CONFIGURATION.md.

# --- required
GITHUB_REPO=<your-github-user>/<your-private-repo>   # YOUR private copy of this repository: Flux follows it
BASE_DOMAIN=<your-domain>                            # your Cloudflare zone, for example mydomain.org (the apps are <name>.<domain>)
AGE_PUBLIC_KEY=<your-age-public-key>                 # age-keygen -y <your key file>: starts with age1, never the AGE-SECRET-KEY

# --- optional: filled by oracle-always-free scripts/make-reader-key.sh too (set them here only if you prefer)
# OCI_REGION=<your-home-region>                      # for example eu-frankfurt-1
# OCI_NAMESPACE=<your-object-storage-namespace>      # first label of `tofu -chdir=bootstrap output -raw s3_endpoint` in oracle-always-free

# --- optional (defaults of the files shown)
# CLUSTER_NAME=oke-free                              # a label in alerts; the sibling repositories call the cluster oke-free
# POD_CIDR=10.244.0.0/16                             # the pod network of the cluster (oracle-always-free infra/network.tf)
# HOME_TAILNET_FQDN=chatops.<your-tailnet>.ts.net    # only for the optional ntfy layers
# NTFY_TOPIC=cluster                                 # ntfy topic for cluster results (restore test, previews)

# --- optional layers: true|false. A line you leave out keeps the file as it is (default: all off, image automation on)
# LAYER_MONITORING=false          # Prometheus + OpenTelemetry to Grafana Cloud / New Relic: create its secrets first (docs/RECIPES.md recipe 7)
# LAYER_SECURITY=false            # CrowdSec on Traefik's access log, alerts to YOUR ntfy: needs an ntfy server and token
# LAYER_PREVIEWS=false            # pull-request preview environments (docs/RECIPES.md recipe 8)
# LAYER_RESTORE_TEST=false        # weekly restore test: written for one kind of backup, adapt it first (recipe 5)
# LAYER_IMAGE_AUTOMATION=true     # Flux commits new image digests to main: needs a deploy key WITH write access (see README, security notes)
# LAYER_HOME_NTFY_EGRESS=false    # tailnet egress to a private ntfy on your own server
# LAYER_CHATOPS_RBAC=false        # RBAC role for a chat bot that reaches the API through the tailnet
